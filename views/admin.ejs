<%- include("partials/header") %>
<div class="page-heading"><div><div class="eyebrow">RESTRICTED ACCESS / ADMIN</div><h1>ПАНЕЛЬ УПРАВЛЕНИЯ<span class="green">.</span></h1><p>Управление участниками и аудит действий.</p></div><span class="status-pill admin-pill">ADMIN ACCESS</span></div>
<div class="admin-stats"><div class="stat-card"><span>ПОЛЬЗОВАТЕЛИ</span><strong><%= counts.users %></strong></div><div class="stat-card"><span>ПРЕДМЕТЫ В КОЛЛЕКЦИЯХ</span><strong><%= counts.items %></strong></div><div class="stat-card"><span>УРОВЕНЬ ДОСТУПА</span><strong class="green">ROOT</strong></div></div>
<section class="panel section-panel"><div class="panel-heading"><div><div class="eyebrow">USER MANAGEMENT</div><h2>Пользователи</h2></div><span class="muted small">Последние 100 аккаунтов</span></div>
<div class="table-scroll"><table><thead><tr><th>ПОЛЬЗОВАТЕЛЬ</th><th>STEAM ID</th><th>ВИРТУАЛЬНЫЕ ОЧКИ</th><th>СТАТУС</th><th>ДЕЙСТВИЯ</th></tr></thead><tbody>
<% users.forEach(u => { %><tr><td><div class="table-user"><img src="<%= u.avatar_url || 'https://placehold.co/64x64/101713/56f2a6?text=D' %>" alt=""><strong><%= u.display_name %></strong></div></td><td class="mono"><%= u.steam_id %></td><td><form class="inline-form" method="post" action="/admin/user/<%= u.id %>/points"><input type="number" name="points" min="0" max="1000000" value="<%= u.virtual_points %>" required><button class="btn btn-small btn-ghost" type="submit">Сохранить</button></form></td><td><span class="status-pill <%= u.is_banned ? 'status-banned' : '' %>"><%= u.is_banned ? 'ЗАБЛОКИРОВАН' : 'АКТИВЕН' %></span></td><td><div class="admin-actions"><form method="post" action="/admin/user/<%= u.id %>/ban"><button class="btn btn-small <%= u.is_banned ? 'btn-primary' : 'btn-danger' %>" type="submit"><%= u.is_banned ? 'Разблокировать' : 'Блокировать' %></button></form><form method="post" action="/admin/user/<%= u.id %>/rename" class="rename-form"><input name="display_name" maxlength="40" placeholder="Новое имя" required><button class="btn btn-small btn-ghost" type="submit">Имя</button></form></div></td></tr><% }) %>
<% if (!users.length) { %><tr><td colspan="5" class="muted">Пользователей пока нет.</td></tr><% } %>
</tbody></table></div></section>
<section class="panel section-panel"><div class="panel-heading"><div><div class="eyebrow">AUDIT TRAIL</div><h2>Журнал действий</h2></div></div><div class="activity-list"><% logs.forEach(log => { %><div class="activity-row"><span class="activity-mark">⌁</span><div><strong><%= log.action.replaceAll("_"," ") %></strong><p><%= log.display_name || "Система" %> · <%= log.details %></p></div><time><%= new Date(log.created_at).toLocaleString("ru-RU") %></time></div><% }) %><% if (!logs.length) { %><p class="muted">Журнал пуст.</p><% } %></div></section>
<%- include("partials/footer") %>
